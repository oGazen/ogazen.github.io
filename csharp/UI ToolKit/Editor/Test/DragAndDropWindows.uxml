<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:ListView focusable="true" name="config" show-border="true" style="position: absolute; left: 0; top: 0; bottom: 0; min-width: 150px; max-width: 200px; align-items: flex-start; justify-content: center; right: auto; border-top-left-radius: 3px; border-bottom-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px;" />
    <ui:ListView focusable="true" fixed-item-height="50" name="hexagon" show-border="true" show-foldout-header="false" show-bound-collection-size="false" style="top: 0; right: 0; bottom: 0; position: absolute; max-width: 80px; min-width: 50px; min-height: 20px; justify-content: center; align-items: center; left: auto; border-top-left-radius: 3px; border-bottom-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px;" />
    <ui:GroupBox name="middle" style="position: absolute; bottom: 30%; left: 155px; right: 55px; top: 0; background-color: rgb(99, 99, 99); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-top-left-radius: 3px; border-bottom-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0;">
        <ui:ScrollView mode="Horizontal" name="scrollcontent" style="left: 0; top: 0; right: 0; bottom: 0; position: absolute; justify-content: flex-start; align-items: stretch;" />
    </ui:GroupBox>
    <ui:GroupBox name="detail" style="bottom: 0; right: 55px; left: 155px; position: absolute; background-color: rgb(70, 70, 70); margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; border-top-left-radius: 3px; border-bottom-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; top: 70%;">
        <ui:ScrollView name="scrolldetail" style="border-top-width: 8px; border-bottom-width: 8px;" />
    </ui:GroupBox>
    <ui:VisualElement name="line" style="left: 155px; right: 55px; position: absolute; justify-content: center; align-items: stretch; max-width: none; max-height: 1px; min-height: 1px; min-width: auto; width: auto; height: 1px; top: auto; bottom: 30%;">
        <ui:VisualElement name="lineinside" style="height: 10px; max-height: 10px; min-height: 10px;" />
    </ui:VisualElement>
    <ui:GroupBox name="btns" style="position: absolute; bottom: 0; left: 0; min-width: 150px; max-width: 150px; min-height: auto; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; justify-content: flex-end; top: auto;">
        <ui:Button text="导出" display-tooltip-when-elided="true" name="submit" />
    </ui:GroupBox>
</ui:UXML>
